# Build output
build/
out/
cmake-build-*/

# .NET build output
**/bin/
**/obj/

# Runtime logs
*.log

# Runtime-generated settings
*.uvesettings
imgui.ini

# Runtime-generated asset registry and scene/prefab/bundle files
*.uveassetdb
*.uvescene
*.uveprefab
*.uvebundle

# Runtime-generated shader program-binary cache (ShaderManagerUVE)
/shader_cache/
*.uveshadercache

# Runtime-generated asset-database registry files written by test fixtures
# (e.g. MakeEditorTestConfigUVE()'s config.assetDatabaseFilePath) when tests
# are run from the repository root instead of a build/test working directory.
*_tests_assets.json
*_tests_settings.json

# Runtime-generated import cache (AssetImportCacheUVE)
/DerivedData/
*.uveimportcache

# IDE
.vs/
.vscode/
.idea/
*.user

# OS
.DS_Store
